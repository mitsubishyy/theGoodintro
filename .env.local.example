# Copy this file to `.env.local` and fill in the value.
# `.env.local` is git-ignored. Set the same variable in the Vercel
# project settings (Production + Preview) for the live form to work.

# Google Apps Script Web App URL that appends each /apply submission
# to your private Google Sheet. See SHEETS_SETUP.md for the 5-minute setup.
# If this is left unset, the form still works but submissions are only
# written to the server log (fine for previewing the form).
SHEETS_WEBHOOK_URL=

# ── Cold-outreach one-click RSVP (separate from the public site) ──────
# Secret used to sign the per-recipient Accept/Decline links. Generate one
# with:  openssl rand -base64 32   — then set the SAME value here and in
# Vercel, and pass it to scripts/make-rsvp-links.mjs when generating links.
# If you rotate this, every link already in someone's inbox stops working.
RSVP_SECRET=

# Google Apps Script Web App URL for the RSVP responses sheet. Its own sheet,
# separate from the /apply one. See RSVP_SETUP.md. If unset, responses are
# only written to the server log (fine for previewing).
RSVP_WEBHOOK_URL=
