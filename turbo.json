{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
        "SUPABASE_SERVICE_ROLE_KEY",
        "NEXT_PUBLIC_APP_URL",
        "EMAIL_TOKEN_SECRET"
      ],
      "passThroughEnv": [
        "XERO_*",
        "RESEND_API_KEY",
        "EMAIL_*",
        "CRON_SECRET",
        "DEMO_*",
        "NEXT_PUBLIC_DEMO_OPEN_ACCESS"
      ]
    }
  }
}
