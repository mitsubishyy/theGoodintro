{
  "name": "thegoodintro-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:pricing": "npm run test --workspace=@thegoodintro/pricing",
    "test:platform": "npm run test --workspace=@thegoodintro/platform",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "test:db": "bash scripts/test-db.sh",
    "build:web": "turbo run build --filter=@thegoodintro/web",
    "build:platform": "turbo run build --filter=@thegoodintro/platform",
    "dev:web": "turbo run dev --filter=@thegoodintro/web",
    "dev:platform": "turbo run dev --filter=@thegoodintro/platform",
    "indexnow": "npm run indexnow --workspace=@thegoodintro/web",
    "check:copy": "node scripts/check-copy.js",
    "check:drift": "node scripts/drift-sentinel.js"
  },
  "devDependencies": {
    "supabase": "^2.101.0",
    "turbo": "^2.5.0"
  }
}
