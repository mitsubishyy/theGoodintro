# Copy to .env.local and fill in. .env.local is git-ignored.
# Staging values come from the Supabase project settings (API).

# Public — safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret — never expose to the browser, never commit. Used for
# system/webhook writes that must bypass RLS (later pillars).
SUPABASE_SERVICE_ROLE_KEY=
