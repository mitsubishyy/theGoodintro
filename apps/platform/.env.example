# TheGoodIntro platform — required environment variables.
# Copy to .env.local and fill in. NEVER commit real secrets. Separate dev/prod
# values. See OPS_AND_COMPLIANCE.md, SECURITY_AND_COMPLIANCE.md, COLD_START_GAPS.md.

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign the exec email accept/decline/forward links (EMAIL_ACTIONS.md)
EMAIL_TOKEN_SECRET=

# ── Supabase (DB / Auth / storage) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email: Resend (transactional sender) ─────────────────────────────────────
RESEND_API_KEY=
# Must be on the authenticated sending subdomain, e.g. no-reply@send.thegoodintro.com
EMAIL_FROM=

# ── Error monitoring: Sentry ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Payments: Xero (invoice + paid webhook) ──────────────────────────────────
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Webhook signing key (used by app/api/webhooks/xero/route.ts)
XERO_WEBHOOK_KEY=

# ── Meeting attendance: Zoom (server-to-server OAuth + webhook) ───────────────
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# ── Microsoft Graph: Teams attendance + Outlook calendar ─────────────────────
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_WEBHOOK_SECRET=

# ── Google Calendar (invites, free/busy, sync) ───────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Calendly (vendor vetting call) ───────────────────────────────────────────
CALENDLY_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Slack (single new-signup alert) ──────────────────────────────────────────
SLACK_WEBHOOK_URL=
