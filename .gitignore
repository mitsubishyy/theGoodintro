.DS_Store
# No trailing slash: linked worktrees symlink node_modules to the main checkout,
# and a trailing slash matches directories only, leaving the symlinks untracked.
node_modules
.env
.env.local
.env*.local
*.log

# Next.js (nested per-app in the monorepo, so not rooted)
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Turborepo
.turbo/

# Vercel
.vercel

# Local MCP config (machine-specific, may hold tokens)
.mcp.json

# Codex CLI local config (machine-specific MCP wiring)
.codex/

# Stale nested duplicate of the repo (do not track)
/theGoodintro/

# Generated from the .md briefs, regenerable
*.docx
